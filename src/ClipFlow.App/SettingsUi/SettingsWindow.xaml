<Window x:Class="ClipFlow.App.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipFlow 設定" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="16">
    <GroupBox Header="ホットキー" Padding="8">
      <StackPanel>
        <TextBlock Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="入力欄を選んで、割り当てたいキーの組み合わせを押してください（Ctrl / Alt / Win のいずれかを含めてください）。" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition /><RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Text="範囲キャプチャ → マスキング" VerticalAlignment="Center" />
          <TextBox x:Name="CaptureHotkeyBox" Grid.Column="1" IsReadOnly="True" Margin="0,2" PreviewKeyDown="OnHotkeyKeyDown" />
          <TextBlock Grid.Row="1" Text="切り取りコピー（マスクなし）" VerticalAlignment="Center" />
          <TextBox x:Name="CutHotkeyBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,2" PreviewKeyDown="OnHotkeyKeyDown" />
          <TextBlock Grid.Row="2" Text="シークレットモード切替" VerticalAlignment="Center" />
          <TextBox x:Name="SecretHotkeyBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,2" PreviewKeyDown="OnHotkeyKeyDown" />
        </Grid>
        <TextBlock x:Name="HotkeyStatus" Foreground="#C62828" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </GroupBox>

    <GroupBox Header="クリップボード" Padding="8" Margin="0,8,0,0">
      <StackPanel>
        <CheckBox x:Name="ExcludeHistoryBox" Content="通常モードでも Windows のクリップボード履歴・クラウド同期に残さない（推奨）" />
        <TextBlock Foreground="#555" TextWrapping="Wrap" Margin="20,4,0,0"
                   Text="シークレットモード中は、この設定に関わらず常に除外します。除外は Windows が対応する形式を付けて依頼するもので、他のクリップボード管理アプリがそれに従うかはアプリ次第です。" />
      </StackPanel>
    </GroupBox>

    <GroupBox Header="ランチャー" Padding="8" Margin="0,8,0,0">
      <CheckBox x:Name="BadgeVisibleBox" Content="フローティングバッジを表示する" />
    </GroupBox>

    <GroupBox Header="注釈の既定値" Padding="8" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="色:" VerticalAlignment="Center" Margin="0,0,4,0" />
        <ComboBox x:Name="AnnotationColorBox" Width="96" Margin="0,0,16,0" />
        <TextBlock Text="線幅:" VerticalAlignment="Center" Margin="0,0,4,0" />
        <ComboBox x:Name="AnnotationWidthBox" Width="64" />
      </StackPanel>
    </GroupBox>

    <GroupBox Header="JPEG 出力" Padding="8" Margin="0,8,0,0">
      <StackPanel>
        <CheckBox x:Name="RoundJpegBox" Content="黒塗りを 16 画素境界まで外側に広げる（既定・推奨）" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="品質:" VerticalAlignment="Center" Margin="0,0,4,0" />
          <Slider x:Name="JpegQualitySlider" Minimum="50" Maximum="100" Width="200" TickFrequency="5" IsSnapToTickEnabled="True" />
          <TextBlock Text="{Binding Value, ElementName=JpegQualitySlider}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Foreground="#E65100" TextWrapping="Wrap" Margin="0,6,0,0" x:Name="JpegNote" />
      </StackPanel>
    </GroupBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="保存" Width="88" IsDefault="True" Margin="0,0,8,0" Click="OnSaveClick" />
      <Button Content="キャンセル" Width="88" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
