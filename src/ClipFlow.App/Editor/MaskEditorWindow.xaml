<Window x:Class="ClipFlow.App.Editor.MaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipFlow マスクエディタ"
        MinWidth="720" MinHeight="360"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Topmost="False">
  <DockPanel>
    <!-- 上部バナー -->
    <StackPanel DockPanel.Dock="Top">
      <Border x:Name="SecretBanner" Style="{StaticResource SecretBanner}" Visibility="Collapsed">
        <TextBlock Foreground="White" Text="シークレットモード中：ClipFlow の履歴に保存せず、Windows のクリップボード履歴・クラウド同期からも除外します。" TextWrapping="Wrap" />
      </Border>
      <Border x:Name="WeakMaskBanner" Style="{StaticResource WarningBanner}" Visibility="Collapsed">
        <TextBlock x:Name="WeakMaskText" TextWrapping="Wrap" FontWeight="SemiBold" />
      </Border>
      <Border x:Name="ConfirmedBanner" Background="#E8F5E9" BorderBrush="#43A047" BorderThickness="0,0,0,2" Padding="12,6" Visibility="Collapsed">
        <TextBlock Text="確定しました。元画像は破棄しました（これ以降は元に戻せません）。" FontWeight="SemiBold" />
      </Border>
    </StackPanel>

    <!-- 編集ツールバー -->
    <WrapPanel x:Name="EditBar" DockPanel.Dock="Top" Margin="8,6">
      <TextBlock Text="ツール:" VerticalAlignment="Center" Margin="0,0,4,0" />
      <RadioButton x:Name="ToolSelect" Content="選択 (V)" GroupName="Tool" Margin="2,0" VerticalAlignment="Center" Checked="OnToolChanged" />
      <RadioButton x:Name="ToolMask" Content="マスク (M)" GroupName="Tool" Margin="2,0" VerticalAlignment="Center" IsChecked="True" Checked="OnToolChanged" />
      <RadioButton x:Name="ToolFrame" Content="枠 (R)" GroupName="Tool" Margin="2,0" VerticalAlignment="Center" Checked="OnToolChanged" />
      <RadioButton x:Name="ToolArrow" Content="矢印 (A)" GroupName="Tool" Margin="2,0,12,0" VerticalAlignment="Center" Checked="OnToolChanged" />

      <TextBlock Text="マスク種別:" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox x:Name="MaskKindBox" Width="96" Margin="0,0,12,0" SelectionChanged="OnMaskKindChanged">
        <ComboBoxItem Content="黒塗り" IsSelected="True" />
        <ComboBoxItem Content="モザイク" />
        <ComboBoxItem Content="ぼかし" />
      </ComboBox>

      <TextBlock Text="注釈の色:" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox x:Name="ColorBox" Width="80" Margin="0,0,8,0" SelectionChanged="OnAnnotationStyleChanged" />
      <TextBlock Text="線幅:" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox x:Name="LineWidthBox" Width="56" Margin="0,0,12,0" SelectionChanged="OnAnnotationStyleChanged" />

      <Button x:Name="DeleteButton" Content="削除 (Del)" Padding="8,2" Margin="2,0" Click="OnDeleteClick" />
      <Button x:Name="UndoButton" Content="元に戻す (Ctrl+Z)" Padding="8,2" Margin="2,0" Click="OnUndoClick" />
      <Button x:Name="RedoButton" Content="やり直し (Ctrl+Y)" Padding="8,2" Margin="2,0,12,0" Click="OnRedoClick" />

      <CheckBox x:Name="PreviewToggle" Content="適用後をプレビュー (P)" VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnPreviewToggled" Unchecked="OnPreviewToggled" />
      <Button x:Name="ConfirmButton" Content="確定 (Ctrl+Enter)" Padding="12,2" FontWeight="SemiBold" Click="OnConfirmClick" />
    </WrapPanel>

    <!-- 出力バー（確定後に有効） -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="8,6">
      <StackPanel>
        <WrapPanel x:Name="OutputBar" IsEnabled="False">
          <TextBlock Text="形式:" VerticalAlignment="Center" Margin="0,0,4,0" />
          <RadioButton x:Name="FormatPng" Content="PNG（推奨）" GroupName="Format" IsChecked="True" VerticalAlignment="Center" Margin="2,0" Checked="OnFormatChanged" />
          <RadioButton x:Name="FormatJpeg" Content="JPEG" GroupName="Format" VerticalAlignment="Center" Margin="2,0,12,0" Checked="OnFormatChanged" />
          <CheckBox x:Name="RoundJpegBox" Content="黒塗りを 16 画素境界まで外側に広げる（推奨）" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
          <Button x:Name="CopyButton" Content="クリップボードにコピー (Ctrl+C)" Padding="10,2" Margin="2,0" Click="OnCopyClick" />
          <Button x:Name="SaveButton" Content="名前を付けて保存... (Ctrl+S)" Padding="10,2" Margin="2,0" Click="OnSaveClick" />
        </WrapPanel>
        <TextBlock x:Name="JpegWarning" Foreground="#E65100" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
        <DockPanel Margin="0,4,0,0">
          <Button DockPanel.Dock="Right" Content="閉じる" Padding="12,2" Click="OnCloseClick" />
          <TextBlock x:Name="StatusText" Foreground="#555" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- 画像 -->
    <Border Background="#3A3A3A" Padding="8">
      <Viewbox x:Name="SurfaceHost" StretchDirection="DownOnly" Stretch="Uniform">
        <Canvas x:Name="Surface" Background="Transparent" ClipToBounds="True"
                MouseLeftButtonDown="OnSurfaceMouseDown" MouseMove="OnSurfaceMouseMove"
                MouseLeftButtonUp="OnSurfaceMouseUp" LostMouseCapture="OnSurfaceLostCapture">
          <Canvas.LayoutTransform>
            <ScaleTransform x:Name="SurfaceScale" ScaleX="1" ScaleY="1" />
          </Canvas.LayoutTransform>
          <Image x:Name="SurfaceImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" />
          <Canvas x:Name="OverlayLayer" IsHitTestVisible="False" />
        </Canvas>
      </Viewbox>
    </Border>
  </DockPanel>
</Window>
