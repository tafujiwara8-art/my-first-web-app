<Application x:Class="ClipFlow.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#1E88E5" />
    <SolidColorBrush x:Key="SecretBrush" Color="#6A1B9A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF3E0" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FB8C00" />
    <Style x:Key="SecretBanner" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SecretBrush}" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style x:Key="WarningBanner" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource WarningBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
  </Application.Resources>
</Application>
