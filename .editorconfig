root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,xaml,yml,yaml,json,manifest}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# 名前空間・using
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# 型・式
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_readonly_field = true:warning
csharp_prefer_braces = when_multiline:suggestion

# 不要コード
dotnet_diagnostic.IDE0051.severity = warning  # 未使用の private メンバー
dotnet_diagnostic.IDE0052.severity = warning  # 読み取られない private メンバー

# 命名
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.private_const_pascal.symbols = private_consts
dotnet_naming_rule.private_const_pascal.style = pascal
dotnet_naming_rule.private_const_pascal.severity = warning
dotnet_naming_symbols.private_consts.applicable_kinds = field
dotnet_naming_symbols.private_consts.applicable_accessibilities = private
dotnet_naming_symbols.private_consts.required_modifiers = const

# Win32 相互運用の構造体・定数名は Windows SDK の表記に合わせる
[src/ClipFlow.Windows/Interop/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE1006.severity = none
dotnet_naming_rule.private_fields_underscore.severity = none
dotnet_naming_rule.private_const_pascal.severity = none

# テストはメソッド名にアンダースコアを使う
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none
